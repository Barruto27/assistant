# systemd unit for the personal Telegram assistant (plan Section 1).
#
# Install on the home server:
#   sudo cp deploy/assistant.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now assistant
#
# Watch it:
#   systemctl status assistant
#   journalctl -u assistant -f
#
# Adjust User and WorkingDirectory to match the server before installing.

[Unit]
Description=Personal Telegram Assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kaan
WorkingDirectory=/home/kaan/assistant
ExecStart=/home/kaan/assistant/.venv/bin/python -m bot.main

# Restart on crash, but back off so a config error doesn't spin the CPU.
Restart=always
RestartSec=10
StartLimitIntervalSec=300
StartLimitBurst=5

# Unbuffered so journalctl shows output as it happens.
Environment=PYTHONUNBUFFERED=1

# Modest hardening — the bot only needs its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kaan/assistant

[Install]
WantedBy=multi-user.target

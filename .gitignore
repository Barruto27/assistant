.DS_Store
.env
*.sqlite
# The trailing glob matters: SQLite's -wal and -shm sidecars are not
# matched by *.sqlite3, and both got committed once already. The -wal
# happened to be empty that time; it holds real rows when it isn't.
*.sqlite3*
__pycache__/
*.pyc
.venv/
venv/

# Runtime artifacts
logs/

# Keep the directory, never its contents (git can't re-include a file whose
# parent directory is excluded, so exclude the contents rather than the dir).
secrets/*
!secrets/.gitkeep

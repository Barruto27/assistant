# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- Telegram (Session 1) ---
# From @BotFather after /newbot
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. The bot ignores everyone else.
# Get it by messaging @userinfobot, or check the log line the bot prints
# the first time an unknown user messages it.
OWNER_TELEGRAM_ID=

# --- Claude API (Session 4 on) ---
ANTHROPIC_API_KEY=
# Model used for classification / parsing / brief generation.
CLAUDE_MODEL=claude-sonnet-5

# --- Paths ---
# SQLite file location. Default sits next to the repo; gitignored via *.sqlite3.
DB_PATH=db/assistant.sqlite3
# Log file with full error detail (Section 8).
LOG_PATH=logs/assistant.log

# --- Google OAuth (Session 6 on) ---
# Path to the OAuth client secrets JSON downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRETS=secrets/google_client_secret.json
# Where the personal-account token is cached after first auth.
GOOGLE_TOKEN_PERSONAL=secrets/token_personal.json
# Where the university-account token is cached (may be unused if Workspace blocks API access).
GOOGLE_TOKEN_UNIVERSITY=secrets/token_university.json

# --- Weather (Session 7 on) ---
# Open-Meteo needs no key. If you switch providers, put the key here.
WEATHER_LATITUDE=43.7735
WEATHER_LONGITUDE=-79.5019
WEATHER_TIMEZONE=America/Toronto
